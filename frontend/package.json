{
  "name": "jatibarang-ccus-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fieldman CCUS screening workbench frontend (Feature 006).",
  "scripts": {
    "gen:types": "openapi-typescript ../specs/005-screening-api/contracts/openapi.yaml -o src/api/types.gen.ts",
    "bake:terrain": "node scripts/bake-terrain.mjs",
    "capture:canned": "node scripts/capture-canned.mjs",
    "predev": "npm run gen:types",
    "dev": "vite",
    "prebuild": "npm run gen:types",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.1",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "three": "^0.169.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "geotiff": "^2.1.3",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
