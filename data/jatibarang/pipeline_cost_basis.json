    "booster_capex_usd": "booster_fixed_capex_usd + booster_variable_capex_usd_per_kw * power_kw",
    "annual_booster_energy_usd": "power_kw * operating_hours_per_year * electricity_usd_per_kwh",
    "trucking_transport_usd_per_tonne": "trucking_usd_per_tonne_km * one_way_distance_km",
    "trucking_delivered_usd_per_tonne": "loading + liquefaction + reconditioning + distance_transport + co2_supply",
    "present_value_factor": "(1 - (1 + discount_rate)^(-project_life_years)) / discount_rate",
    "levelized_transport_usd_per_tonne": "transport_lifecycle_present_value / (annual_tonnes * present_value_factor)"
  },
